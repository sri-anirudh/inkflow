# Supabase (dev project)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=            # postgresql+asyncpg://... used by Alembic + the app's DB engine (Card 2, ADR-018). Use the SESSION POOLER connection string (postgres.<ref>@aws-x-region.pooler.supabase.com:5432), not the direct db.<ref>.supabase.co host — the direct host is IPv6-only and unreachable from Docker's default network (Card 3).

# Redis
REDIS_URL=redis://redis:6379

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# App
JWT_JWKS_URL=            # Supabase's JWKS endpoint, for API-side JWT verification (Deliverable 2, Batch 2)
ENVIRONMENT=development
