# Supabase (dev project)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=            # Direct Postgres connection (postgresql+asyncpg://...), used by Alembic + the app's DB engine. Not in Deliverable 10's original var list — added in Card 2, needed for ADR-018 (SQLAlchemy/Alembic).

# Redis
REDIS_URL=redis://redis:6379

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# App
JWT_JWKS_URL=            # Supabase's JWKS endpoint, for API-side JWT verification (Deliverable 2, Batch 2)
ENVIRONMENT=development
